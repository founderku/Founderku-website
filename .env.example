# Isi ini dengan data project Supabase kamu sendiri
# (Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-key-di-sini

# JANGAN pernah taruh SERVICE_ROLE_KEY di kode yang jalan di browser.
# Ini cuma dipakai server (misal nanti webhook Xendit), aman ditaruh di
# environment variable Vercel karena tidak pernah dikirim ke browser.
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-di-sini

# Dari Xendit Dashboard > Settings > API Keys (Secret Key) dan
# Settings > Webhooks (Verification Token). Isi ini di Vercel Environment
# Variables langsung, JANGAN pernah taruh nilai asli kunci live di file
# manapun yang di-commit ke GitHub.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
