# Isi ini dengan data project Supabase kamu sendiri
# (Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-key-di-sini

# JANGAN pernah taruh SERVICE_ROLE_KEY di kode yang jalan di browser.
# Ini cuma dipakai server (misal nanti webhook Xendit), aman ditaruh di
# environment variable Vercel karena tidak pernah dikirim ke browser.
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-di-sini

# Dari Xendit Dashboard > Settings > API Keys (Secret Key) dan
# Settings > Webhooks (Verification Token). Isi ini di Vercel Environment
# Variables langsung, JANGAN pernah taruh nilai asli kunci live di file
# manapun yang di-commit ke GitHub.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# Asisten AI (tombol chat). Buat kunci di Google AI Studio
# (aistudio.google.com > Get API key). Isi di Vercel Environment
# Variables saja, JANGAN di-commit. Tanpa kunci ini, tombol chat tetap
# tampil tapi menampilkan "Asisten AI belum aktif".
GEMINI_API_KEY=
# Opsional: ganti model tanpa ubah kode (bawaan: gemini-flash-lite-latest)
GEMINI_MODEL=

# Cadangan otomatis kalau Gemini penuh/gagal. Buat kunci di
# console.groq.com > API Keys. Isi di Vercel saja, JANGAN di-commit.
# Cukup salah satu (GEMINI_API_KEY atau GROQ_API_KEY) supaya AI aktif.
GROQ_API_KEY=
# Opsional (bawaan: openai/gpt-oss-120b)
GROQ_MODEL=
